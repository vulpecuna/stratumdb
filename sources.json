      "min": "20.0.0"
    }
  },
  "wordpress": {
    "min": "5.0"
  },
  "releases": {
    "apache-httpd": {
      "kind": "html",
      "url": [
        "https://archive.apache.org/dist/httpd/"
      ],
      "pattern": "httpd-([0-9]+\\.[0-9]+\\.[0-9]+)\\.tar\\.gz"
    },
    "drupal": {
      "kind": "html",
      "url": [
        "https://updates.drupal.org/release-history/drupal/all"
      ],
      "pattern": "<version>([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)</version>"
    },
    "forgejo": {
      "kind": "gitea-api",
      "url": "https://codeberg.org/api/v1/repos/forgejo/forgejo/releases",
      "pattern": "^v([0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9]+)?)$"
    },
    "gitea": {
      "kind": "html",
      "url": [
        "https://dl.gitea.com/gitea/"
      ],
      "pattern": "\"/gitea/([0-9]+\\.[0-9]+\\.[0-9]+)/?\""
    },
    "grafana": {
      "kind": "json",
      "url": "https://grafana.com/api/grafana/versions",
      "path": [
        "items",
        "*"
      ],
      "field": "version",
      "where": [
        "channels",
        "stable"
      ],
      "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)$"
    },
    "haproxy": {
      "kind": "html-tree",
      "url": "https://www.haproxy.org/download/",
      "branch": "\"([0-9]+\\.[0-9]+)/\"",
      "sub": "https://www.haproxy.org/download/{b}/src/",
      "pattern": "haproxy-([0-9][0-9.]*[0-9])\\.tar\\.gz"
    },
    "jenkins": {
      "kind": "html",
      "url": [
        "https://get.jenkins.io/war/"
      ],
      "pattern": "\"([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)/\""
    },
    "jenkins-lts": {
      "kind": "html",
      "url": [
        "https://get.jenkins.io/war-stable/"
      ],
      "pattern": "\"([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)/\""
    },
    "joomla": {
      "kind": "json",
      "url": "https://downloads.joomla.org/api/v1/releases/cms",
      "path": [
        "releases",
        "*"
      ],
      "field": "version"
    },
    "keycloak": {
      "kind": "html",
      "url": [
        "https://repo1.maven.org/maven2/org/keycloak/keycloak-core/maven-metadata.xml"
      ],
      "pattern": "<version>([^<]+)</version>"
    },
    "mailcatcher": {
      "kind": "json",
      "url": "https://rubygems.org/api/v1/versions/mailcatcher.json",
      "path": [
        "*"
      ],
      "field": "number"
    },
    "nginx": {
      "kind": "html",
      "url": [
        "https://nginx.org/download/"
      ],
      "pattern": "nginx-([0-9]+\\.[0-9]+\\.[0-9]+)\\.tar\\.gz"
    },
    "php": {
      "kind": "html",
      "url": [
        "https://www.php.net/releases/"
      ],
      "pattern": "php-([0-9]+\\.[0-9]+\\.[0-9]+)\\.tar\\.gz"
    },
    "phpmyadmin": {
      "kind": "html",
      "url": [
        "https://www.phpmyadmin.net/files/"
      ],
      "pattern": "phpMyAdmin/([0-9]+\\.[0-9]+\\.[0-9]+)/"
    },
    "tomcat": {
      "kind": "html",
      "url": [
        "https://archive.apache.org/dist/tomcat/tomcat-8/",
        "https://archive.apache.org/dist/tomcat/tomcat-9/",
        "https://archive.apache.org/dist/tomcat/tomcat-10/",
        "https://archive.apache.org/dist/tomcat/tomcat-11/"
      ],
      "pattern": "v([0-9]+\\.[0-9]+\\.[0-9]+(?:-M[0-9]+)?)/"
    },
    "umbraco": {
      "kind": "json",
      "url": "https://api.nuget.org/v3-flatcontainer/umbraco.cms.core/index.json",
      "path": [
        "versions",
        "*"
      ]
    },
    "vault": {
      "kind": "hashicorp",
      "url": "https://api.releases.hashicorp.com/v1/releases/vault",
      "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)$"
    },
    "wordpress": {
      "kind": "json-keys",
      "url": "https://api.wordpress.org/core/stable-check/1.0/"
    },
    "zendto": {
      "kind": "html",
      "url": [
        "https://zend.to/changelog"
      ],
      "pattern": "Version ([0-9]+\\.[0-9]+-[0-9]+)"
    }
  },
